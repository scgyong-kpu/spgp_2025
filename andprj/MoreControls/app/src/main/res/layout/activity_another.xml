<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AnotherActivity">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/anotherMainTextView"
        android:text="@string/another_main_text_view"
        android:textSize="40sp"
        android:layout_centerInParent="true"
        />
    <kr.ac.tukorea.ge.scgyong.spgp2025.morecontrols.MyView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignStart="@id/anotherMainTextView"
        android:layout_below="@id/anotherMainTextView"
        android:layout_alignEnd="@id/anotherMainTextView"
        />

</RelativeLayout>