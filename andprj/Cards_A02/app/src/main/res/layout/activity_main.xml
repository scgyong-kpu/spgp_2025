<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!--
    닫는 태그는 </LinearLayout>입니다.
    자식 요소가 없으면 <LinearLayout /> 처럼 자체 닫는 태그로 작성

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        <TextureView
            android:layout_width=""
            android:layout_height=""
            />
    </LinearLayout>
    -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
        <TextView
            android:id="@+id/scoreTextView"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textSize="30sp"
            android:text="Flips: 0"
            />

        <!-- Layout XML에도 Resource String 적용 / 버튼의 텍스트를 strings.xml에 저장된 문자열로 설정하는 코드
        -->
        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_restart"
            android:onClick="onBtnRestart"
            />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        >
        <ImageButton
            android:id="@+id/card_00"
            style="@style/cardButtonStyle" />
        <ImageButton
            android:id="@+id/card_01"
            style="@style/cardButtonStyle" />
        <ImageButton
            android:id="@+id/card_02"
            style="@style/cardButtonStyle" />
        <ImageButton
            android:id="@+id/card_03"
            style="@style/cardButtonStyle" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        >
        <ImageButton
            android:id="@+id/card_10"
            style="@style/cardButtonStyle" />
        <ImageButton
            android:id="@+id/card_11"
            style="@style/cardButtonStyle" />
        <ImageButton
            android:id="@+id/card_12"
            style="@style/cardButtonStyle" />
        <ImageButton
            android:id="@+id/card_13"
            style="@style/cardButtonStyle" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        >
        <ImageButton
            android:id="@+id/card_20"
            style="@style/cardButtonStyle" />
        <ImageButton
            android:id="@+id/card_21"
            style="@style/cardButtonStyle" />
        <ImageButton
            android:id="@+id/card_22"
            style="@style/cardButtonStyle" />
        <ImageButton
            android:id="@+id/card_23"
            style="@style/cardButtonStyle" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        >
        <ImageButton
            android:id="@+id/card_30"
            style="@style/cardButtonStyle" />
        <ImageButton
            android:id="@+id/card_31"
            style="@style/cardButtonStyle" />
        <ImageButton
            android:id="@+id/card_32"
            style="@style/cardButtonStyle" />
        <ImageButton
            android:id="@+id/card_33"
            style="@style/cardButtonStyle" />
    </LinearLayout>



</LinearLayout>